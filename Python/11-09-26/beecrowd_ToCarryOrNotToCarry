pi = 3.14159

val1,val2,val3 = map(float, input().split())
triangulo = (val1 * val3)/2
acirc = val3 * val3 * pi
trap = ((val1+val2) * val3) / 2
quad = val2 * val2
rect = val1 * val2
print(f'''TRIANGULO: {triangulo:.3f}
CIRCULO: {acirc:.3f}
TRAPEZIO: {trap:.3f}
QUADRADO: {quad:.3f}
RETANGULO: {rect:.3f}''')

